FROM debian:bookworm-slim AS corebuild
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake ninja-build pkg-config libmariadb-dev libssl-dev ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /src/core
COPY core/ .
RUN cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release && cmake --build build --parallel 1 && ctest --test-dir build --output-on-failure

FROM python:3.13.15-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libmariadb3 libssl3 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY shim-python/requirements-prod.txt /tmp/requirements-prod.txt
RUN pip install --no-cache-dir -r /tmp/requirements-prod.txt
WORKDIR /app
COPY --from=corebuild /src/core/build/libfvs_core.so /usr/local/lib/libfvs_core.so
COPY --from=corebuild /src/core/build/fvs_migrate /usr/local/bin/fvs_migrate
COPY shim-python/ /app/shim-python/
COPY workers/ /app/workers/
COPY migrations/ /app/migrations/
COPY deploy/ /app/deploy/
RUN ldconfig && useradd -r -u 10001 -m fvs && mkdir -p /app/var/vouchers && chown -R fvs:fvs /app
USER fvs
ENV FVS_CORE_LIB=/usr/local/lib/libfvs_core.so PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app/shim-python
EXPOSE 8000
CMD ["sh","/app/deploy/preflight.sh","api","gunicorn","-c","/app/deploy/gunicorn.conf.py","app:application"]
