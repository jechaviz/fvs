-- Replace database/user/host/password values before execution. Never commit real secrets.
CREATE USER 'fvs_runtime'@'10.%' IDENTIFIED BY 'REPLACE_RUNTIME_PASSWORD' REQUIRE SSL;
GRANT SELECT, INSERT, UPDATE, DELETE ON fvs.* TO 'fvs_runtime'@'10.%';

CREATE USER 'fvs_migrate'@'10.%' IDENTIFIED BY 'REPLACE_MIGRATION_PASSWORD' REQUIRE SSL;
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, DROP, INDEX, REFERENCES ON fvs.* TO 'fvs_migrate'@'10.%';

CREATE USER 'fvs_backup'@'10.%' IDENTIFIED BY 'REPLACE_BACKUP_PASSWORD' REQUIRE SSL;
GRANT SELECT, SHOW VIEW, TRIGGER ON fvs.* TO 'fvs_backup'@'10.%';
