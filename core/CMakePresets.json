{
  "version": 3,
  "configurePresets": [
    {"name":"release","generator":"Ninja","binaryDir":"${sourceDir}/build/release","cacheVariables":{"CMAKE_BUILD_TYPE":"Release"}},
    {"name":"asan","generator":"Ninja","binaryDir":"${sourceDir}/build/asan","cacheVariables":{"CMAKE_BUILD_TYPE":"Debug","CMAKE_C_FLAGS":"-fsanitize=address,undefined -fno-omit-frame-pointer","CMAKE_SHARED_LINKER_FLAGS":"-fsanitize=address,undefined","CMAKE_EXE_LINKER_FLAGS":"-fsanitize=address,undefined"}}
  ],
  "buildPresets": [
    {"name":"release","configurePreset":"release"},
    {"name":"asan","configurePreset":"asan"}
  ],
  "testPresets": [
    {"name":"release","configurePreset":"release","output":{"outputOnFailure":true}},
    {"name":"asan","configurePreset":"asan","output":{"outputOnFailure":true},"environment":{"ASAN_OPTIONS":"detect_leaks=1:abort_on_error=1","UBSAN_OPTIONS":"halt_on_error=1:print_stacktrace=1"}}
  ]
}
