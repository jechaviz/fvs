# Environment: development | staging | production
FVS_ENV=development

# Runtime MySQL account: DML only in production
FVS_DB_HOST=mysql
FVS_DB_PORT=3306
FVS_DB_NAME=fvs
FVS_DB_USER=fvs_runtime
FVS_DB_PASSWORD=replace-with-long-random-runtime-password
FVS_DB_CONNECT_TIMEOUT=5
FVS_DB_READ_TIMEOUT=10
FVS_DB_WRITE_TIMEOUT=10
FVS_DB_LOCK_WAIT_TIMEOUT=5
FVS_MIGRATION_LOCK_TIMEOUT=30
FVS_DB_SSL_CA=
FVS_DB_SSL_CERT=
FVS_DB_SSL_KEY=
FVS_ALLOW_INSECURE_DB=0

# Migration account: DDL only; falls back to runtime vars in development
FVS_MIGRATE_DB_HOST=
FVS_MIGRATE_DB_PORT=
FVS_MIGRATE_DB_NAME=
FVS_MIGRATE_DB_USER=
FVS_MIGRATE_DB_PASSWORD=
FVS_SCHEMA_REQUIRED=001_current.sql

# API / workers
FVS_PYTHON_WORKERS=16
FVS_PYTHON_REQUEST_TIMEOUT=15
FVS_WORKER_IDLE_SECONDS=2
FVS_WORKER_HEARTBEAT_SECONDS=15
FVS_WORKER_STALE_SECONDS=90
FVS_OUTBOX_LEASE_SECONDS=300
FVS_MAINTENANCE_INTERVAL_SECONDS=60
FVS_OPEN_CART_TTL_SECONDS=86400
FVS_VOUCHER_DIR=/app/var/vouchers
FVS_MESSAGE_ID_DOMAIN=fvs.local

# Public origin / security
FVS_PUBLIC_BASE_URL=http://localhost:8080
# Optional HTTPS MapLibre style URL. Empty uses the built-in OpenStreetMap raster style.
FVS_MAP_STYLE_URL=
FVS_API_BASE_URL=http://localhost:8080
FVS_ALLOWED_ORIGINS=http://localhost:8080
FVS_COOKIE_SECURE=0
FVS_HOLD_SECONDS=900
FVS_CHECKOUT_HOLD_SECONDS=1200
FVS_TERMS_VERSION=2026-09-17
# Send the raw key only from the admin client. Server stores SHA-256 hex only.
FVS_ADMIN_KEY_SHA256=REPLACE_WITH_SHA256_HEX

# Payment providers enabled in this deployment
FVS_PAYMENT_PROVIDERS=stripe,mercadopago
STRIPE_PUBLISHABLE_KEY=pk_test_replace
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
MERCADOPAGO_ACCESS_TOKEN=APP_USR-replace
MERCADOPAGO_WEBHOOK_SECRET=replace

# Email. Production worker preflight requires smtp.
FVS_EMAIL_MODE=log
FVS_SMTP_HOST=
FVS_SMTP_PORT=587
FVS_SMTP_STARTTLS=1
FVS_SMTP_USER=
FVS_SMTP_PASSWORD=
FVS_SMTP_FROM=reservas@example.com
FVS_EMAIL_CC=

# Local development DB only
MYSQL_ROOT_PASSWORD=replace-root-password
FVS_MYSQL_IMAGE=mysql:8.4.12

# Backup / restore accounts (recommended separate credentials)
FVS_BACKUP_DB_USER=
FVS_BACKUP_DB_PASSWORD=
FVS_BACKUP_DIR=./backups
FVS_RESTORE_DB_USER=
FVS_RESTORE_DB_PASSWORD=
FVS_RESTORE_ADMIN_USER=
FVS_RESTORE_ADMIN_PASSWORD=
# Destructive in-place production restore is blocked unless explicitly enabled.
FVS_ALLOW_INPLACE_RESTORE=0

# Hybrid support (AI + human agents)
FVS_SUPPORT_AI_ENABLED=1
OPENAI_API_KEY=replace-with-openai-api-key
FVS_SUPPORT_AI_MODEL=gpt-5.6-luna
FVS_SUPPORT_KB_PATH=/app/docs/SUPPORT_KB.md
# Only SHA-256 of the operator key belongs on the server.
FVS_AGENT_KEY_SHA256=REPLACE_WITH_SHA256_HEX

# Growth / social campaign automation
FVS_MARKETING_ENABLED=1
FVS_MARKETING_CHANNELS=meta,instagram,google,tiktok,linkedin,x,webhook
FVS_MARKETING_LEASE_SECONDS=180
FVS_MARKETING_IDLE_SECONDS=2
FVS_MARKETING_HTTP_TIMEOUT=20
FVS_MARKETING_SIGNING_SECRET=replace-with-long-random-signing-secret
# Point each enabled channel at its official API adapter or an internal provider gateway.
FVS_MARKETING_META_URL=
FVS_MARKETING_META_TOKEN=
FVS_MARKETING_INSTAGRAM_URL=
FVS_MARKETING_INSTAGRAM_TOKEN=
FVS_MARKETING_GOOGLE_URL=
FVS_MARKETING_GOOGLE_TOKEN=
FVS_MARKETING_TIKTOK_URL=
FVS_MARKETING_TIKTOK_TOKEN=
FVS_MARKETING_LINKEDIN_URL=
FVS_MARKETING_LINKEDIN_TOKEN=
FVS_MARKETING_X_URL=
FVS_MARKETING_X_TOKEN=
FVS_MARKETING_WEBHOOK_URL=
FVS_MARKETING_WEBHOOK_TOKEN=
FVS_MARKETING_ATTRIBUTION_ENABLED=1

# Social commerce / shoppable feeds and inbound leads
FVS_SOCIAL_COMMERCE_ENABLED=1
# Store only the SHA-256 of the feed key on the server.
FVS_SOCIAL_FEED_KEY_SHA256=REPLACE_WITH_SHA256_HEX
# HMAC secret used to authenticate inbound lead/webhook payloads.
FVS_SOCIAL_INBOUND_SECRET=replace-with-long-random-social-inbound-secret
